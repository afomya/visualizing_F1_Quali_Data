 RowBox[{
  RowBox[{
   RowBox[{"xy", "=", 
    RowBox[{"N", "[", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"2", ")"}], " ", "Scale", " ", "XY", " ", "to", " ", "print", " ",
     "footprint"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"targetX", "=", "120"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"targetY", "=", "80"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"baseH", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hMax", "=", "18"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"minx", ",", "maxx"}], "}"}], "=", 
   RowBox[{"MinMax", "[", 
    RowBox[{"xy", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"miny", ",", "maxy"}], "}"}], "=", 
   RowBox[{"MinMax", "[", 
    RowBox[{"xy", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sx", "=", 
   RowBox[{"targetX", "/", 
    RowBox[{"(", 
     RowBox[{"maxx", "-", "minx"}], ")"}]}]}], ";", 
  RowBox[{"sy", "=", 
   RowBox[{"targetY", "/", 
    RowBox[{"(", 
     RowBox[{"maxy", "-", "miny"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xyMM", "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", "minx"}], ")"}], "*", 
          "sx"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "miny"}], ")"}], "*", 
          "sy"}]}], "}"}], "&"}], "/@", "xy"}], ")"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"3", ")"}], " ", "Bin", " ", "into", " ", "a", " ", "grid", " ", 
